{
  "ConnectionStrings": {
    "MaisComprasConnection": "__SET_VIA_USER_SECRETS_OR_CONNECTIONSTRINGS__MAISCOMPRASCONNECTION__",
    "ErpConnection": "__SET_VIA_USER_SECRETS_OR_CONNECTIONSTRINGS__ERPCONNECTION__"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bootstrap": {
    "Secret": "",
    "AllowedCandidateEmails": []
  },
  "Identity": {
    "Session": {
      "AbsoluteExpirationHours": 12,
      "InactivityTimeoutMinutes": 30
    },
    "Otp": {
      "Corporate": {
        "Provider": ""
      },
      "Throttle": {
        "MaxSolicitacoesPorJanela": 3,
        "JanelaMinutos": 15,
        "CooldownSegundos": 60
      }
    }
  },
  "ErpIntegration": {
    "TimeoutSeconds": 30,
    "BusinessUnits": {
      "DEFAULT": { "ErpSistema": "SOMA_DESENV" },
      "SOMA": { "ErpSistema": "SOMA_DESENV" },
      "GRUPO-SOMA": { "ErpSistema": "SOMA_DESENV" }
    },
    "SomaDesenvol": {
      "Schema": "dbo",
      "Table": "FORNECEDORES",
      "FiliaisSchema": "dbo",
      "FiliaisTable": "CADASTRO_CLI_FOR",
      "CentrosCustoSchema": "dbo",
      "CentrosCustoTable": "CENTROS_CUSTO"
    }
  },
  "CnpjConsulta": {
    "Provider": "BrasilApi",
    "BaseUrl": "https://brasilapi.com.br/api/cnpj/v1/",
    "TimeoutSeconds": 10
  },
  "AI": {
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1/"
    }
  }
}
