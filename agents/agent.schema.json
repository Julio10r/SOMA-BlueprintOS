{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-blueprintos.local/agents/agent.schema.json",
  "title": "SOMA BlueprintOS Agent Manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "id", "name", "version", "type", "status", "owner", "responsibility", "implementation", "runtime", "capabilities", "capability_ownership", "delegation", "gap_policy", "connections", "data", "governance", "knowledge", "observability", "tests", "relationships", "catalog"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": 1.1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "type": { "enum": ["runtime", "knowledge", "operational", "hybrid"] },
    "status": { "enum": ["active", "planned", "deprecated", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "responsibility": { "$ref": "#/$defs/responsibility" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "capability_ownership": { "$ref": "#/$defs/capabilityOwnership" },
    "delegation": { "$ref": "#/$defs/delegation" },
    "gap_policy": { "$ref": "#/$defs/gapPolicy" },
    "connections": { "$ref": "#/$defs/connections" },
    "data": { "$ref": "#/$defs/data" },
    "governance": { "$ref": "#/$defs/governance" },
    "knowledge": { "$ref": "#/$defs/knowledge" },
    "observability": { "$ref": "#/$defs/observability" },
    "tests": { "$ref": "#/$defs/tests" },
    "relationships": { "$ref": "#/$defs/relationships" },
    "catalog": { "$ref": "#/$defs/catalog" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stringList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "(?i)(password|passwd|secret|token|cookie|api[_-]?key|connection[_-]?string)\\s*[:=]" } },
    "pathList": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "responsibility": {
      "type": "object", "additionalProperties": false,
      "required": ["objective", "responsibilities", "non_goals", "escalation_rules"],
      "properties": { "objective": { "type": "string", "minLength": 1 }, "responsibilities": { "$ref": "#/$defs/stringList" }, "non_goals": { "$ref": "#/$defs/stringList" }, "escalation_rules": { "$ref": "#/$defs/stringList" } }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["code_paths", "prompt_paths", "context_paths", "runbook_paths", "script_paths", "docs_paths", "di_registration"],
      "properties": { "code_paths": { "$ref": "#/$defs/pathList" }, "prompt_paths": { "$ref": "#/$defs/pathList" }, "context_paths": { "$ref": "#/$defs/pathList" }, "runbook_paths": { "$ref": "#/$defs/pathList" }, "script_paths": { "$ref": "#/$defs/pathList" }, "docs_paths": { "$ref": "#/$defs/pathList" }, "di_registration": { "type": ["string", "null"] } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["implemented", "interface", "factory_supported", "constructor_dependencies", "dependencies"],
      "properties": { "implemented": { "type": "boolean" }, "interface": { "type": ["string", "null"] }, "factory_supported": { "type": "boolean" }, "constructor_dependencies": { "$ref": "#/$defs/stringList" }, "dependencies": { "$ref": "#/$defs/stringList" } }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["tools", "allowed_operations", "forbidden_operations"],
      "properties": { "tools": { "$ref": "#/$defs/stringList" }, "allowed_operations": { "$ref": "#/$defs/stringList" }, "forbidden_operations": { "$ref": "#/$defs/stringList" } }
    },
    "capabilityOwnership": {
      "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["responsible_agent_id", "ownership", "delegation_required", "direct_execution_by_others_allowed"],
        "properties": { "responsible_agent_id": { "$ref": "#/$defs/id" }, "ownership": { "enum": ["primary", "complementary"] }, "delegation_required": { "type": "boolean" }, "direct_execution_by_others_allowed": { "type": "boolean" } }
      }
    },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["cross_cutting", "bypass_allowed", "participation_criteria"],
      "properties": { "cross_cutting": { "type": "boolean" }, "bypass_allowed": { "const": false }, "participation_criteria": { "$ref": "#/$defs/stringList" } }
    },
    "gapPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_bypass_allowed", "allow_learning_existing_agent", "allow_new_agent_proposal", "explicit_human_approval_required_for_new_agent", "material_capability_change_requires_human_approval"],
      "properties": { "direct_bypass_allowed": { "const": false }, "allow_learning_existing_agent": { "type": "boolean" }, "allow_new_agent_proposal": { "type": "boolean" }, "explicit_human_approval_required_for_new_agent": { "const": true }, "material_capability_change_requires_human_approval": { "const": true } }
    },
    "connectionProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration_reference", "environment", "access_intent", "classification"],
      "properties": { "configuration_reference": { "type": "string", "minLength": 1 }, "environment": { "type": "string", "minLength": 1 }, "access_intent": { "enum": ["read-only", "governed-write", "AINDA_NAO_MAPEADO"] }, "classification": { "enum": ["Public", "Internal", "Confidential", "AINDA_NAO_MAPEADO"] } }
    },
    "connections": {
      "type": "object", "additionalProperties": false,
      "required": ["profiles", "credential_policy"],
      "properties": {
        "profiles": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/connectionProfile" } },
        "credential_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["strategy", "secret_storage", "individual_identity_required", "least_privilege", "privilege_escalation_allowed", "prompt_for_secret_allowed"],
          "properties": { "strategy": { "enum": ["none", "user-managed", "service-identity-managed"] }, "secret_storage": { "$ref": "#/$defs/stringList" }, "individual_identity_required": { "type": "boolean" }, "least_privilege": { "const": true }, "privilege_escalation_allowed": { "const": false }, "prompt_for_secret_allowed": { "const": false } }
        }
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["systems", "resources", "classifications", "pii_allowed", "sensitive_pii_allowed", "secrets_allowed"],
      "properties": { "systems": { "$ref": "#/$defs/stringList" }, "resources": { "$ref": "#/$defs/stringList" }, "classifications": { "$ref": "#/$defs/stringList" }, "pii_allowed": { "type": "boolean" }, "sensitive_pii_allowed": { "type": "boolean" }, "secrets_allowed": { "const": false } }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only", "can_propose_write", "can_execute_write", "can_execute_destructive_operation", "policy_engine_required", "requires_action_proposal_for", "approval_required_for", "audit_required", "default_risk", "enforcement_status"],
      "properties": { "read_only": { "type": "boolean" }, "can_propose_write": { "type": "boolean" }, "can_execute_write": { "type": "boolean" }, "can_execute_destructive_operation": { "type": "boolean" }, "policy_engine_required": { "type": "boolean" }, "requires_action_proposal_for": { "$ref": "#/$defs/stringList" }, "approval_required_for": { "$ref": "#/$defs/stringList" }, "audit_required": { "type": "boolean" }, "default_risk": { "enum": ["Green", "Yellow", "Red", "Unknown"] }, "enforcement_status": { "enum": ["ENFORCED", "DOCUMENTAL", "PARTIAL", "PLANNED"] } }
    },
    "knowledge": { "type": "object", "additionalProperties": false, "required": ["memory_paths", "provenance_labels", "update_rules"], "properties": { "memory_paths": { "$ref": "#/$defs/pathList" }, "provenance_labels": { "$ref": "#/$defs/stringList" }, "update_rules": { "$ref": "#/$defs/stringList" } } },
    "observability": { "type": "object", "additionalProperties": false, "required": ["logs", "metrics", "audit_events", "redaction_required"], "properties": { "logs": { "$ref": "#/$defs/stringList" }, "metrics": { "$ref": "#/$defs/stringList" }, "audit_events": { "$ref": "#/$defs/stringList" }, "redaction_required": { "type": "boolean" } } },
    "tests": { "type": "object", "additionalProperties": false, "required": ["unit", "integration", "safety", "contract"], "properties": { "unit": { "$ref": "#/$defs/pathList" }, "integration": { "$ref": "#/$defs/pathList" }, "safety": { "$ref": "#/$defs/pathList" }, "contract": { "$ref": "#/$defs/pathList" } } },
    "relationships": { "type": "object", "additionalProperties": false, "required": ["upstream_agents", "downstream_agents", "workflows", "conflicts_with"], "properties": { "upstream_agents": { "$ref": "#/$defs/stringList" }, "downstream_agents": { "$ref": "#/$defs/stringList" }, "workflows": { "$ref": "#/$defs/stringList" }, "conflicts_with": { "$ref": "#/$defs/stringList" } } },
    "catalog": { "type": "object", "additionalProperties": false, "required": ["summary", "display_order"], "properties": { "summary": { "type": "string", "minLength": 1 }, "display_order": { "type": "integer", "minimum": 0 } } }
  }
}
