# Copie este arquivo para ".env" (ou ".env.local") e ajuste conforme o ambiente.
# NUNCA commite um .env real com valores de producao.
#
# URL base da API do BlueprintOS.Api. Deixe vazio (ou omita) para usar o
# proxy de desenvolvimento configurado em vite.config.ts (chamadas relativas
# como "/fornecedores" sao redirecionadas para o backend automaticamente).
# Defina um valor quando o frontend precisar apontar diretamente para o
# backend (ex: back e front rodando em processos/portas separados sem proxy).
VITE_API_BASE_URL=http://localhost:5188
