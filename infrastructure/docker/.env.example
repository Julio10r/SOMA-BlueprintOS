# Nunca commitar senhas reais.

ASPNETCORE_ENVIRONMENT=Development

# Banco oficial de desenvolvimento (+Compras)
ConnectionStrings__MaisComprasConnection=Server=192.168.9.98;Database=MAISCOMPRAS;User Id=__SET_ME__;Password=__SET_ME__;Encrypt=True;TrustServerCertificate=True

